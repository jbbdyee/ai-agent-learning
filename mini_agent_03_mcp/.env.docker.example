# Copy this file to .env before running Docker Compose.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

POSTGRES_DB=mini_agent
POSTGRES_USER=mini_agent
POSTGRES_PASSWORD=change-me

# These are informational/override values. compose.yml supplies container DNS names.
BACKEND_API_URL=http://backend:8000
TRAVEL_MCP_URL=http://mcp-travel:8010/mcp
HEALTH_MCP_URL=http://mcp-health:8011/mcp
DATABASE_URL=postgresql://mini_agent:change-me@postgres:5432/mini_agent
REDIS_URL=redis://redis:6379/0
